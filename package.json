{
  "name": "docent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "docent": "tsx packages/cli/src/index.ts",
    "build": "pnpm --filter @docent/web build && pnpm --filter docentflow build",
    "dev": "pnpm --parallel --filter @docent/server --filter @docent/web dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@docent/analyze": "workspace:*",
    "@docent/extract": "workspace:*",
    "@docent/llm": "workspace:*",
    "@docent/server": "workspace:*",
    "@docent/voice": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
