# Docent's own keys. Copy to .env (gitignored) in a checkout; an npm install keeps them in ~/.docent/.env.
# Settings in the app writes this file for you. Restart after editing it by hand.

# Optional: use the Anthropic API instead of your Claude Code or Codex sign-in.
# ANTHROPIC_API_KEY=

# Optional cloud voices. https://play.cartesia.ai/keys · https://fish.audio
# CARTESIA_API_KEY=
# FISH_AUDIO_API_KEY=
